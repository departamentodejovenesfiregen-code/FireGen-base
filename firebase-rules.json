{
  "rules": {
    ".read": false,
    ".write": false,
    "historial_cambios": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "miembros": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "asistencias": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "informes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "estrategias": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "analisis": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "alertasRescate": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "configuracion": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === root.child('configuracion/adminEmail').val()"
    },
    "usuarios": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === root.child('configuracion/adminEmail').val()"
    }
  }
}
