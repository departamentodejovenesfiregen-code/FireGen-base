{
  "rules": {
    ".read": false,
    ".write": false,
    "historial_cambios": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "miembros": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "asistencias": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "informes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "estrategias": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "analisis": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "alertasRescate": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "configuracion": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === root.child('configuracion/adminEmail').val()"
    },
    "usuarios": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === root.child('configuracion/adminEmail').val()"
    },
    "historicoMensual": {
      ".read": "auth != null",
      "$periodo": {
        ".write": "auth != null && !data.exists() && newData.exists() && newData.child('cerrado').val() === true"
      }
    },
    "historicoAnual": {
      ".read": "auth != null",
      "$anio": {
        ".write": "auth != null && !data.exists() && newData.exists() && newData.child('cerrado').val() === true"
      }
    },
    "seguimientos": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "rendicionCuentas": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "notificaciones": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "mensajes": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}