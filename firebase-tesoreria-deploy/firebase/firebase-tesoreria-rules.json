{
  "rules": {
    ".read": false,
    ".write": false,
    
    "config": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    
    "usuarios": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      },
      ".write": "auth != null"
    },
    
    "movimientos": {
      ".read": "auth != null",
      "$periodo": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('periodos').child($periodo).child('estado').val() === 'ABIERTO'",
        "$movId": {
          ".write": "auth != null && root.child('periodos').child($periodo).child('estado').val() === 'ABIERTO'",
          ".validate": "!newData.exists() || newData.hasChildren(['tipo', 'monto', 'fecha', 'periodo'])"
        }
      }
    },
    
    "deudas": {
      ".read": "auth != null",
      "$deudaId": {
        ".write": "auth != null && (!newData.exists() || root.child('periodos').child(newData.child('periodo').val()).child('estado').val() === 'ABIERTO')",
        ".validate": "newData.hasChildren(['montoOriginal', 'montoPagado', 'estado']) && newData.child('montoPagado').val() <= newData.child('montoOriginal').val()"
      }
    },
    
    "periodos": {
      ".read": "auth != null",
      "$periodo": {
        ".write": "auth != null && (!data.exists() || data.child('estado').val() !== 'CERRADO' || (newData.exists() && newData.child('estado').val() === 'CERRADO' && data.child('saldoFinal').val() == newData.child('saldoFinal').val()))",
        ".validate": "newData.hasChild('estado')"
      }
    },
    
    "campanas": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    
    "actividades": {
      ".read": "auth != null",
      "$actId": {
        ".write": "auth != null && (!newData.exists() || root.child('periodos').child(newData.child('periodo').val()).child('estado').val() === 'ABIERTO')",
        ".validate": "!newData.exists() || (newData.hasChildren(['nombre', 'periodo']) && (!newData.hasChild('platosVendidos') || newData.child('platosVendidos').val() <= newData.child('platosPreparados').val()) && (!newData.hasChild('platosCobrados') || newData.child('platosCobrados').val() <= newData.child('platosVendidos').val()))"
      }
    },
    
    "checklist": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    
    "inventario": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    
    "informes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    
    "auditoria": {
      ".read": "auth != null",
      ".write": "auth != null && !data.exists()"
    }
  }
}
